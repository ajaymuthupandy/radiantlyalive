# Copy to .env.local and fill in as needed. All variables are optional.

# Canonical site URL used for metadata, sitemap and structured data.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional JSON endpoints (Formspree, Mailchimp proxy, serverless function, CRM webhook).
# Without them the newsletter form opens the existing Radiantly Alive sign-up page
# and the contact form opens the visitor's email app with the message prepared.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Scholarship waitlist and guide sign-ups (same JSON shape: { email, name?, form }).
NEXT_PUBLIC_WAITLIST_ENDPOINT=
